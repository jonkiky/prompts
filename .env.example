# Export these variables into the process environment; this file is not auto-loaded.
HUB_AUTH_MODE=demo
HUB_DATA=data
HUB_BASE_URL=http://127.0.0.1:8765

# Company rollout: set HUB_AUTH_MODE=oidc and configure HTTPS plus your provider.
# HUB_BASE_URL=https://skills.example.company
# HUB_OIDC_ISSUER=https://your-company-identity-provider
# HUB_OIDC_CLIENT_ID=
# HUB_OIDC_CLIENT_SECRET=
# HUB_EMAIL_DOMAIN=example.company
# HUB_ADMIN_EMAILS=admin@example.company
# HUB_REVIEWER_EMAILS=reviewer@example.company
